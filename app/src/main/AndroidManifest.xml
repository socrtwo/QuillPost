<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for IMAP / POP3 / SMTP, DNS blocklists and provider autodiscovery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QuillPen (the suite's word processor): detected to offer its embedded editor in compose. -->
    <queries>
        <package android:name="io.github.socrtwo.quillpen" />
        <!-- QuillGrid and QuillStage: "Open in" for spreadsheets and presentations (FileHandoff.kt). -->
        <package android:name="io.github.socrtwo.quillgrid" />
        <package android:name="io.github.socrtwo.quillstage" />
        <provider android:authorities="io.github.socrtwo.quillpen.embed" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.QuillPost">

        <!-- The UI is the embedded web client; keep the Activity (and its WebView) alive across
             rotation and keyboard changes so the mail session is not reloaded. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.QuillPost.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with QuillPost": saved messages (.eml, .msg, winmail.dat, .mht…), contacts and calendars.
                 The file's content decides what is shown, so generic binary types are accepted too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="message/rfc822" />
                <data android:mimeType="message/*" />
                <data android:mimeType="application/vnd.ms-outlook" />
                <data android:mimeType="application/ms-tnef" />
                <data android:mimeType="application/vnd.ms-tnef" />
                <data android:mimeType="multipart/related" />
                <data android:mimeType="application/x-mimearchive" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/directory" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/mac-binhex40" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Share to QuillPost": any file becomes an opened file (and can be sent as an attachment). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Let QuillPost be chosen for mailto: links from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>

        <!-- Hands saved attachments to viewer apps via content:// URIs (Android 8 and 9). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
