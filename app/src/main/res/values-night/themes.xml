<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme: same structure as values/themes.xml with the dark palette of the web UI. -->
    <style name="Theme.QuillPost" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/quillpost_background</item>
    </style>
    <style name="Theme.QuillPost.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/quillpost_topbar</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.QuillPost</item>
    </style>
</resources>
